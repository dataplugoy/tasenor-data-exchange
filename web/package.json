{
  "version": "1.8.1",
  "name": "@tasenor/tadex-web",
  "description": "TaDeX documentation",
  "scripts": {
    "dev": "docusaurus start --port ${DOC_PORT:=7304} --host 0.0.0.0  --config docusaurus.config.dev.ts --no-open --no-minify",
    "build": "docusaurus build --config docusaurus.config.${NODE_ENV}.ts",
    "serve": "docusaurus serve --port ${DOC_PORT:=7304} --host 0.0.0.0 --config docusaurus.config.${NODE_ENV}.ts --no-open",
    "docker": "pnpm build && pnpm serve"
  },
