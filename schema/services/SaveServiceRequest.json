{
  "title": "SaveServiceRequest",
  "description": "Create or update a service. A missing password or key keeps the old one, an empty one removes it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "driver", "url"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "driver": {
      "$ref": "ServiceDriver.json"
    },
    "free": {
      "type": "boolean"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "key": {
      "type": "string"
    }
  }
}
