{
  "title": "CreateFlowPlanRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "projectId", "source", "destination"],
  "properties": {
    "title": {
      "type": "string"
    },
    "projectId": {
      "type": "integer"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "TEST_MOCK",
            "ENABLE_BANKING",
            "MANUAL_UPLOAD",
            "NORDNET"
          ]
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "TEST_MOCK",
            "NO_ACTION"
          ]
        },
        "settings": {
          "type": "object"
        }
      }
    }
  }
}