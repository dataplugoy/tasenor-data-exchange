{
  "$id": "TransactionLine.json",
  "title": "TransactionLine",
  "type": "object",
  "additionalProperties": false,
  "required": ["account", "amount", "text", "extras"],
  "properties": {
    "account": {
      "$ref": "Account.json"
    },
    "amount": {
      "type": ["number", "string"],
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "minimum": 0
    },
    "text": {
      "type": "string"
    },
    "extras": {
      "$ref": "TransactionExtras.json"
    }
  }
}
