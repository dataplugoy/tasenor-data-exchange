{
  "$id": "RuleQuestion.json",
  "title": "RuleQuestion",
  "description": "A question of the project asked for each line matched by a mapping rule using it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectId", "name", "kind", "label", "options"],
  "properties": {
    "id": {
      "type": "integer"
    },
    "projectId": {
      "type": "integer"
    },
    "name": {
      "description": "Identifier used in text templates as {?name}.",
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_]*$"
    },
    "kind": {
      "$ref": "RuleQuestionKind.json"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "RuleQuestionOption.json"
      }
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "usedBy": {
      "description": "Names of the rules using the question, when listing the questions of a project.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
