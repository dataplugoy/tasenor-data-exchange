{
  "$id": "Question.json",
  "title": "Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "help", "label", "variable"],
  "properties": {
    "type": {
      "$ref": "QuestionType.json"
    },
    "args": {
      "$ret": "QuestionArgs.json"
    },
    "help": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "variable": {
      "type": "string",
      "pattern": "[A-Za-z][A-Za-z0-9.]*"
    },
    "example": {
      "$ref": "QuestionExample.json"
    }
  }
}
