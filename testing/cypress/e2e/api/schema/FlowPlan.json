{
  "$id": "FlowPlan.json",
  "title": "FlowPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectId", "title", "state", "lastStamp", "stock"],
  "properties": {
    "id": {
      "type": "integer"
    },
    "projectId": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "state": {
      "type": "object"
    },
    "lastStamp": {
      "type": ["string", "null"],
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "stock": {
      "$ref": "StockData.json"
    },
    "balance": {
      "$ref": "BalanceData.json"
    },
    "created": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "updated": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    }
  }
}
