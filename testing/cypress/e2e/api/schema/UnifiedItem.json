{
  "$id": "UnifiedItem.json",
  "title": "UnifiedItem",
  "type": "object",
  "additionalProperties": false,
  "required": ["time", "data", "processed", "skipped", "error", "inputId", "batchId", "runId"],
  "properties": {
    "id": {
      "type": "integer"
    },
    "time": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "data": {
      "$ref": "UnifiedItemData.json"
    },
    "stockChange": {
      "type": "object"
    },
    "processed": {
      "type": "boolean"
    },
    "skipped": {
      "type": "boolean"
    },
    "inputId": {
      "type": "integer"
    },
    "ruleId": {
      "type": ["null", "integer"]
    },
    "flowPlanId": {
      "type": "integer"
    },
    "batchId": {
      "type": "integer"
    },
    "runId": {
      "type": "integer"
    },
    "created": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "updated": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    }
  }
}
