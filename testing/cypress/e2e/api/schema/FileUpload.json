{
  "$id": "FileUpload",
  "title": "FileUpload",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "type", "data"],
  "properties": {
    "name": {
      "description": "Name of the file",
      "type": "string",
      "minLength": 1
    },
    "type": {
      "description": "MIME type of the uploaded file.",
      "type": "string",
      "pattern": "^([0-9a-fA-F][0-9a-fA-F])*$"
    },
    "data": {
      "description": "Hex encoded binary.",
      "type": "string",
      "pattern": "^([0-9a-fA-F][0-9a-fA-F])*$"
    }
  }
}
