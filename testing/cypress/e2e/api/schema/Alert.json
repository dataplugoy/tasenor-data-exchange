    "id": {
      "type": "integer"
    },
    "userId": {
      "type": "integer"
    },
    "type": {
      "type": "string",
      "enum": [
        "UPLOAD_REQUIRED"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "INTERACTIVE",
        "EMAIL"
      ]
    },
    "url": {
      "type": "string"
    },
    "payload": {
      "type": "string"
    },
    "delivered": {
      "type": ["null", "string"],
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "created": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "updated": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    }
  }
}
