#!/bin/bash
#
# Run all nightly test scripts.
#

FILE=`dirname "${BASH_SOURCE[0]}"`/../../..
ROOT=`readlink -f "$FILE"`

set -e

cd "$ROOT/backend"
pnpm run prisma-client

cd "$ROOT/testing/nightly/"
echo
echo ======
echo MEGALO
echo ======
bin/test-megalo
echo
echo =======
echo HILUNKI
echo =======
bin/test-hilunki
echo
echo ======
echo NIHKEÄ
echo ======
bin/test-nihkea
echo
echo =====
echo TYLSÄ
echo =====
bin/test-tylsa
echo
echo
echo =======
echo SPELÖGA
echo =======
bin/test-speloga
echo
