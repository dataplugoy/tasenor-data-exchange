#!/bin/bash
#
# Run Hilunki scripts.
#

FILE=`dirname "${BASH_SOURCE[0]}"`/../../..
ROOT=`readlink -f "$FILE"`

set -e

#
# Hilunki
#

cd "$ROOT/database"
pnpm load

cd "$ROOT"
bin/tadex.mjs run Nordnet
bin/tadex.mjs upload Nordnet testing/nightly/data/Hilunki.csv
bin/tadex.mjs run Nordnet all
bin/tadex.mjs ledger Nordnet --detail --stock --test testing/nightly/data/Hilunki.json

# To update answer file:
#
# bin/tadex.mjs ledger Nordnet --detail --stock --json > testing/nightly/data/Hilunki.json
