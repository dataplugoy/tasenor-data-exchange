#!/bin/bash
#
# Run Hilunki scripts.
#

FILE=`dirname "${BASH_SOURCE[0]}"`/../../..
ROOT=`readlink -f "$FILE"`

set -e

#
# Hilunki
#

cd "$ROOT/database"
pnpm load

cd "$ROOT"
bin/tadex.mjs run 'Nightly Testing'
bin/tadex.mjs upload 'Nightly Testing' testing/nightly/data/Hilunki.csv
bin/tadex.mjs run 'Nightly Testing' all
bin/tadex.mjs ledger 'Nightly Testing' --stock --test testing/nightly/data/Hilunki.json

# To update answer file:
#
# bin/tadex.mjs ledger 'Nightly Testing' --stock --json > testing/nightly/data/Hilunki.json
