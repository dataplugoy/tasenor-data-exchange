#!/bin/bash
#
# Run Hilunki scripts.
#

FILE=`dirname "${BASH_SOURCE[0]}"`/../../..
ROOT=`readlink -f "$FILE"`

set -e

#
# Hilunki
#

cd "$ROOT"
pnpm load
bin/tadex.mjs setup 'Nightly Testing' '{"tickers": {"iShares MSCI Europe SRI ETF EUR Acc EUR": "iShares MSCI Europe SRI ETF EUR Acc EUR", "SLG OMXH25": "SLG OMXH25", "Xtrackers Comdty ex Agri Swap ETF 1C EUR": "Xtrackers Comdty ex Agri Swap ETF 1C EUR"}, "settings": {"debtAccounts": {"EUR": null, "USD": null}}}'
bin/tadex.mjs run 'Nightly Testing'
bin/tadex.mjs upload 'Nightly Testing' testing/nightly/data/Tylsä.csv
bin/tadex.mjs run 'Nightly Testing' all
bin/tadex.mjs ledger 'Nightly Testing' --stock --test testing/nightly/data/Tylsä.json

# To update answer file:
#
# bin/tadex.mjs ledger 'Nightly Testing' --stock --json > testing/nightly/data/Tylsä.json
