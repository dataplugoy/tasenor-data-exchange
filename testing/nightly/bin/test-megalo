#!/bin/bash
#
# Run Megalo test.
#

FILE=`dirname "${BASH_SOURCE[0]}"`/../../..
ROOT=`readlink -f "$FILE"`

set -e

cd "$ROOT"
pnpm load
bin/tadex.mjs setup 'Nightly Testing' '{"settings": {"debtAccounts": {"EUR": null, "USD": null}}}'
bin/tadex.mjs run 'Nightly Testing'
bin/tadex.mjs upload 'Nightly Testing' testing/nightly/data/Megalo.csv
bin/tadex.mjs run 'Nightly Testing' all
bin/tadex.mjs ledger 'Nightly Testing' --stock --test testing/nightly/data/Megalo.json

# To update answer file:
#
# bin/tadex.mjs ledger 'Nightly Testing' --stock --json > testing/nightly/data/Megalo.json
