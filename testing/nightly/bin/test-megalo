#!/bin/bash
#
# Run Megalo test.
#

FILE=`dirname "${BASH_SOURCE[0]}"`/../../..
ROOT=`readlink -f "$FILE"`

set -e

cd "$ROOT/database"
pnpm load

cd "$ROOT"
bin/tadex.mjs run Nordnet
bin/tadex.mjs upload Nordnet testing/nightly/data/Megalo.csv
bin/tadex.mjs run Nordnet all
bin/tadex.mjs ledger Nordnet --detail --stock --test testing/nightly/data/Megalo.json

# To update answer file:
#
# bin/tadex.mjs ledger Nordnet --detail --stock --json > testing/nightly/data/Megalo.json
