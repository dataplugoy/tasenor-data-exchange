#!/bin/bash
set -e

echo "===============#======================================================================"
echo "STAGING UPDATE ‖"
echo "===============#"
echo

FILE=`dirname "${BASH_SOURCE[0]}"`/..
ROOT=`readlink -f "$FILE"`

REMOTE_USER=debian
REMOTE_SERVER=bookkeeper.stg.tasenor.com
REMOTE_DIR=/home/debian/tasenor-devops/stg.tasenor.com

ssh "$REMOTE_USER@$REMOTE_SERVER" "cd $REMOTE_DIR && git reset --hard && git clean -f -d && git pull -q && ./bin/update"
