[
  {
    "name": "Buying",
    "key": "Buy",
    "filter": "word1 == 'Buy'",
    "result": {
      "type": "'buy'",
      "assetIn": "third(regex('^([a-zA-Z]+) ([.0-9]+) ([a-zA-Z0-9]+)', text))",
      "assetAmountIn": "num(second(regex('^([a-zA-Z]+) ([.0-9]+) ([a-zA-Z0-9]+)', text)))",
      "value": "total == null ? null : -total"
    }
  },
  {
    "name": "Selling",
    "key": "Sell",
    "filter": "word1 == 'Sell'",
    "result": {
      "type": "'sell'",
      "assetOut": "third(regex('^([a-zA-Z]+) ([.0-9]+) ([a-zA-Z0-9]+)', text))",
      "assetAmountOut": "num(second(regex('^([a-zA-Z]+) ([.0-9]+) ([a-zA-Z0-9]+)', text)))",
      "value": "total"
    }
  }
]