{
  "title": "RegisterRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["email", "password", "name"],
  "properties": {
    "email": {
      "type": "string",
      "pattern": "@"
    },
    "password": {
      "type": "string",
      "minLength": 8
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "allowProductAnnouncement": {
      "type": "boolean"
    }
  }
}