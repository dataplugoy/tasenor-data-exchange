{
  "$id": "Setup.json",
  "title": "Setup",
  "type": "object",
  "additionalProperties": false,
  "description": "Flow plan configuration.",
  "properties": {
    "answers": {
      "description": "One-off answers for input items no rule matches, by the answer key of the input item.",
      "type": "object",
      "additionalProperties": {
        "$ref": "UnifiedItemData.json"
      }
    },
    "lineAnswers": {
      "description": "Answers to the questions of the rules, by the answer key of the input item.",
      "type": "object",
      "additionalProperties": {
        "$ref": "LineAnswers.json"
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": true
    },
    "tickers": {
      "type": "object",
      "additionalProperties": true
    },
    "openingState": {
      "description": "Opening balances and assets confirmed by the user for the first batch.",
      "$ref": "OpeningState.json"
    },
    "accountGrouping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "singleStockAccount": {
          "type": "boolean"
        },
        "singleCryptoAccount": {
          "type": "boolean"
        },
        "singleFeeAccount": {
          "type": "boolean"
        },
        "singleProfitAccount": {
          "type": "boolean"
        },
        "singleLossAccount": {
          "type": "boolean"
        },
        "singleIncomeAccount": {
          "type": "boolean"
        },
        "singleExpenseAccount": {
          "type": "boolean"
        },
        "singleDividendAccount": {
          "type": "boolean"
        },
        "singleTaxAccount": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "$ref": "Settings.json"
    }
  }
}
