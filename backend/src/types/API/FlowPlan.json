{
  "$id": "FlowPlan.json",
  "title": "FlowPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectId", "title", "state", "lastStamp", "stock"],
  "properties": {
    "id": {
      "type": "integer"
    },
    "projectId": {
      "type": "integer"
    },
    "project": {
      "$ref": "Project.json"
    },
    "title": {
      "type": "string"
    },
    "ruleSourceHash": {
      "description": "Hash of the driver rule file last synchronized to the rules of this flow plan.",
      "type": ["null", "string"]
    },
    "rulesVersion": {
      "description": "Version of the rules, increased every time the rules are changed.",
      "type": "integer"
    },
    "rulesSaved": {
      "description": "Time of the latest change of the rules.",
      "type": ["string", "null"],
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "setup": {
      "$ref": "Setup.json"
    },
    "state": {
      "type": "object"
    },
    "firstDate": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "lastStamp": {
      "type": ["string", "null"],
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "stock": {
      "$ref": "StockData.json"
    },
    "balance": {
      "$ref": "BalanceData.json"
    },
    "created": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    },
    "updated": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.?[0-9]*Z"
    }
  }
}
