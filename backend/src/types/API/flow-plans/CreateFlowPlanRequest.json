{
  "title": "CreateFlowPlanRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "projectId", "firstDate", "source", "setup"],
  "properties": {
    "title": {
      "type": "string"
    },
    "projectId": {
      "type": "integer"
    },
    "firstDate": {
      "type": "string",
      "pattern": "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": {
          "$ref": "DriverType.json"
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": {
          "$ref": "DriverType.json"
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "copyOutputFrom": {
      "description": "ID of a flow plan of the same user to copy the bookkeeping destination and its settings from instead of `destination`.",
      "type": "integer"
    },
    "setup": {
      "$ref": "Setup.json"
    }
  }
}