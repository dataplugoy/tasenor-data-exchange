{
  "$id": "Question.json",
  "title": "Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "help", "label"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "BOOLEAN"
      ]
    },
    "help": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "variable": {
      "type": "string",
      "pattern": "[A-Za-z][A-Za-z0-9.]*"
    }
  }
}
