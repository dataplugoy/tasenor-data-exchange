[
  {
    "name": "Deposit",
    "key": "Deposit",
    "filter": "Kind == 'Deposit'",
    "result": {
      "type": "'deposit'",
      "value": "Amount",
      "valueAsset": "Currency",
      "service": "'Lynx'"
    }
  },
  {
    "name": "Withdrawal",
    "key": "Withdrawal",
    "filter": "Kind == 'Withdrawal'",
    "result": {
      "type": "'withdrawal'",
      "value": "-Amount",
      "valueAsset": "Currency",
      "service": "'Lynx'"
    }
  },
  {
    "name": "Deposit Correction",
    "key": "TransferAdjustment",
    "filter": "Kind == 'TransferAdjustment' and Amount >= 0",
    "result": {
      "type": "'income'",
      "value": "Amount",
      "valueAsset": "Currency",
      "reason": "'CORRECTION_DEPOSIT'",
      "text": "Description"
    }
  },
  {
    "name": "Withdrawal Correction",
    "key": "TransferAdjustment",
    "filter": "Kind == 'TransferAdjustment' and Amount < 0",
    "result": {
      "type": "'expense'",
      "value": "-Amount",
      "valueAsset": "Currency",
      "reason": "'CORRECTION_WITHDRAWAL'",
      "text": "Description"
    }
  },
  {
    "name": "Stock Buy",
    "key": "Trade",
    "filter": "Kind == 'Trade' and AssetCategory == 'Stocks' and Quantity > 0",
    "result": {
      "type": "'buy'",
      "value": "-Proceeds - Fee",
      "valueAsset": "Currency",
      "assetIn": "Symbol",
      "assetAmountIn": "Quantity",
      "assetTypeIn": "'STOCK'",
      "fee": "-Fee",
      "feeAsset": "Currency"
    }
  },
  {
    "name": "Stock Sell",
    "key": "Trade",
    "filter": "Kind == 'Trade' and AssetCategory == 'Stocks' and Quantity < 0",
    "result": {
      "type": "'sell'",
      "value": "Proceeds",
      "valueAsset": "Currency",
      "assetOut": "Symbol",
      "assetAmountOut": "-Quantity",
      "assetTypeOut": "'STOCK'",
      "fee": "-Fee",
      "feeAsset": "Currency"
    }
  },
  {
    "name": "Forex Buy (Foreign to Local)",
    "key": "Forex",
    "filter": "Kind == 'Forex' and Base == currency and Quantity > 0",
    "result": {
      "type": "'forex'",
      "value": "-Proceeds",
      "valueAsset": "Quote",
      "assetIn": "Base",
      "assetAmountIn": "Quantity",
      "fee": "-Fee",
      "feeAsset": "FeeCurrency",
      "profit": "Profit",
      "rates": "rates(Quote, 1 / Price)"
    }
  },
  {
    "name": "Forex Sell (Local to Foreign)",
    "key": "Forex",
    "filter": "Kind == 'Forex' and Base == currency and Quantity < 0",
    "result": {
      "type": "'forex'",
      "value": "Proceeds",
      "valueAsset": "Quote",
      "assetOut": "Base",
      "assetAmountOut": "-Quantity",
      "fee": "-Fee",
      "feeAsset": "FeeCurrency",
      "profit": "Profit",
      "rates": "rates(Quote, 1 / Price)"
    }
  },
  {
    "name": "Dividend",
