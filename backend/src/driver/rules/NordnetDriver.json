[
  {
    "name": "Deposit",
    "key": "TALLETUS",
    "filter": "Tapahtumatyyppi == 'TALLETUS'",
    "result": {
      "type": "'deposit'",
      "value": "Summa",
      "valueAsset": "Valuutta",
      "account": "'NORDNET_CURRENCY_' + Valuutta",
      "service": "'Nordnet'"
    }
  },
  {
    "name": "Withdrawal",
    "filter": "Tapahtumatyyppi == 'NOSTO'",
    "key": "NOSTO",
    "result": {
      "type": "'withdrawal'",
      "value": "-Summa",
      "valueAsset": "Valuutta",
      "account": "'NORDNET_CURRENCY_' + Valuutta",
      "service": "'Nordnet'"
    }
  },
  {
    "name": "Monthly Saving Fee",
    "key": "ETF_KK SÄÄSTÖN PALVELUMAKSU",
    "filter": "Tapahtumatyyppi == 'ETF_KK SÄÄSTÖN PALVELUMAKSU'",
    "result": {
      "type": "'expense'",
      "value": "-Summa",
      "valueAsset": "Valuutta",
      "account": "'NORDNET_FEE_MONTHLY_SAVING'",
      "text": "Tapahtumateksti"
    }
  },
  {
    "name": "Stock Buy",
    "key": "OSTO",
    "filter": "Tapahtumatyyppi == 'OSTO'",
    "result": {
      "type": "'buy'",
      "value": "-Summa",
      "valueAsset": "Valuutta",
      "assetAmountIn": "Määrä",
      "assetIn": "Arvopaperi",
      "fee": "Kokonaiskulut",
      "feeAsset": "$('Kokonaiskulut Valuutta')"
    }
  },
  {
    "name": "Stock Sell",
    "key": "MYYNTI",
    "filter": "Tapahtumatyyppi == 'MYYNTI'",
    "result": {
      "type": "'sell'",
      "value": "Summa + Kokonaiskulut",
      "valueAsset": "Valuutta",
      "assetOut": "Arvopaperi",
      "assetAmountOut": "Määrä",
      "fee": "Kokonaiskulut",
      "feeAsset": "$('Kokonaiskulut Valuutta')"
    }
  },
  {
    "name": "Dividend",
    "key": "OSINKO",
    "filter": "Tapahtumatyyppi == 'OSINKO'",
    "result": {
      "type": "'income'",
      "value": "Summa",
      "valueAsset": "Valuutta",
      "reason": "'DIVIDEND'",
      "reasonAsset": "Arvopaperi",
      "text": "Tapahtumateksti",
      "rates": "rates(Valuutta, Vaihtokurssi)"
    }
  },
  {
    "name": "Interest Expenses",
    "filter": "Tapahtumatyyppi == 'LAINAKORKO' or Tapahtumatyyppi == 'PÄÄOMIT YLIT.KORKO'",
    "result": {
      "type": "'expense'",
      "value": "-Summa",
      "valueAsset": "Valuutta",
      "account": "'NORDNET_EXPENSE_INTEREST'",
      "reason": "'INTEREST'"
    }
  },
  {
    "name": "Forex Sell",
    "filter": "Tapahtumatyyppi == 'VALUUTAN MYYNTI' and Summa < 0",
    "key": "VALUUTAN MYYNTI",
    "multipart": "Vahvistusnumero",
    "result": {
      "type": "'forex'",
      "service": "'Nordnet'",
      "multipart": "Vahvistusnumero",
      "assetOut": "Valuutta",
      "assetAmountOut": "-Summa",
      "rates": "rates(Valuutta, Vaihtokurssi)"
    }
  },
  {
    "name": "Forex Buy",
    "filter": "Tapahtumatyyppi == 'VALUUTAN OSTO' and Summa > 0",
    "key": "VALUUTAN OSTO",
    "multipart": "Vahvistusnumero",
    "result": {
      "type": "'forex'",
      "service": "'Nordnet'",
      "multipart": "Vahvistusnumero",
      "value": "Summa",
      "valueAsset": "Valuutta"
    }
  }
]