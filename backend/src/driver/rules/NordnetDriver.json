[
  {
    "name": "Deposit",
    "key": "TALLETUS",
    "filter": "Tapahtumatyyppi == 'TALLETUS'",
    "result": {
      "type": "'deposit'",
      "value": "Summa",
      "valueAsset": "Valuutta",
      "service": "'Nordnet'"
    }
  },
  {
    "name": "Withdrawal",
    "filter": "Tapahtumatyyppi == 'NOSTO'",
    "key": "NOSTO",
    "result": {
      "type": "'withdrawal'",
      "value": "-Summa",
      "valueAsset": "Valuutta",
      "service": "'Nordnet'"
    }
  },
  {
    "name": "Monthly Saving Fee",
    "key": "ETF_KK SÄÄSTÖN PALVELUMAKSU",
    "filter": "Tapahtumatyyppi == 'ETF_KK SÄÄSTÖN PALVELUMAKSU'",
    "result": {
      "type": "'expense'",
      "value": "-Summa",
      "valueAsset": "Valuutta",
      "account": "'FEE_MONTHLY_SAVING'",
      "text": "Tapahtumateksti"
    }
  },
  {
    "name": "Stock Buy",
    "key": "OSTO",
    "filter": "Tapahtumatyyppi == 'OSTO'",
    "result": {
      "type": "'buy'",
      "value": "-Summa",
      "valueAsset": "Valuutta",
      "assetAmountIn": "Määrä",
      "assetIn": "Arvopaperi",
      "assetTypeIn": "'STOCK'",
      "fee": "Kokonaiskulut",
      "feeAsset": "$('Kokonaiskulut Valuutta')"
    }
  },
  {
    "name": "Stock Sell",
    "key": "MYYNTI",
    "filter": "Tapahtumatyyppi == 'MYYNTI'",
    "result": {
      "type": "'sell'",
      "value": "Summa + Kokonaiskulut",
      "valueAsset": "Valuutta",
      "assetOut": "Arvopaperi",
      "assetAmountOut": "Määrä",
      "assetTypeOut": "'STOCK'",
      "fee": "Kokonaiskulut",
      "feeAsset": "$('Kokonaiskulut Valuutta')"
    }
  },
  {
    "name": "Dividend",
    "key": "OSINKO",
    "filter": "Tapahtumatyyppi == 'OSINKO'",
    "result": {
      "type": "'income'",
      "value": "Summa",
      "valueAsset": "Valuutta",
      "reason": "'DIVIDEND'",
      "reasonAsset": "Arvopaperi",
      "text": "Tapahtumateksti",
      "rates": "rates(Valuutta, Vaihtokurssi)"
    }
  },
  {
    "name": "Interest Expenses",
    "filter": "Tapahtumatyyppi == 'LAINAKORKO' or Tapahtumatyyppi == 'PÄÄOMIT YLIT.KORKO'",
    "result": {
      "type": "'expense'",
      "value": "-Summa",
      "valueAsset": "Valuutta",
      "account": "'EXPENSE_INTEREST'",
      "reason": "'INTEREST'"
    }
  },
  {
    "name": "Forex Sell (Foreign to Local)",
    "filter": "Tapahtumatyyppi == 'VALUUTAN MYYNTI' and Summa < 0 and currency != Valuutta",
    "key": "VALUUTAN MYYNTI",
    "result": {
      "type": "'forex'",
      "multipart": "Vahvistusnumero",
      "assetOut": "Valuutta",
      "assetAmountOut": "-Summa",
      "rates": "rates(Valuutta, Vaihtokurssi)"
    }
  },
  {
    "name": "Forex Buy (Foreign to Local)",
    "filter": "Tapahtumatyyppi == 'VALUUTAN OSTO' and Summa > 0 and currency == Valuutta",
    "key": "VALUUTAN OSTO",
    "result": {
      "type": "'forex'",
      "multipart": "Vahvistusnumero",
      "value": "Summa",
      "valueAsset": "Valuutta"
    }
  },
  {
    "name": "Forex Sell (Local to Foreign)",
    "filter": "Tapahtumatyyppi == 'VALUUTAN MYYNTI' and Summa < 0 and currency == Valuutta",
    "key": "VALUUTAN MYYNTI",
    "result": {
      "type": "'forex'",
      "multipart": "Vahvistusnumero",
      "value": "-Summa",
      "valueAsset": "Valuutta"
    }
  },
  {
    "name": "Forex Buy (Local to Foreign)",
    "filter": "Tapahtumatyyppi == 'VALUUTAN OSTO' and Summa > 0 and currency != Valuutta",
    "key": "VALUUTAN OSTO",
    "result": {
      "type": "'forex'",
      "multipart": "Vahvistusnumero",
      "assetIn": "Valuutta",
      "assetAmountIn": "Summa",
      "rates": "rates($('Kokonaiskulut Valuutta'), Vaihtokurssi)"
    }
  },
  {
    "name": "Instrument renaming",
    "filter": "Tapahtumatyyppi == 'VAIHTO AP-OTTO'",
    "key": "VAIHTO AP-OTTO",
    "result": {
      "type": "'rename'",
      "multipart": "Vahvistusnumero",
      "assetOut": "Arvopaperi",
      "text": "Tapahtumateksti"
    }
  },
  {
    "name": "Instrument renaming",
    "filter": "Tapahtumatyyppi == 'VAIHTO AP-JÄTTÖ'",
    "key": "VAIHTO AP-JÄTTÖ",
    "result": {
      "type": "'rename'",
      "multipart": "Vahvistusnumero",
      "assetIn": "Arvopaperi",
      "assetAmountIn": "Määrä",
      "assetTypeIn": "'STOCK'",
      "value": "Summa",
      "valueAsset": "Valuutta"
    }
  }
]