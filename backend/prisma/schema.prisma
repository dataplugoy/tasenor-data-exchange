datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
}

model Settings {
  id          Int             @id @default(autoincrement())
  type        InputSourceType @unique
  url         String?
  certificate String?
  apikey      String?
  user        String?
  password    String?
  options     Json            @default("{}")
  @@map(name: "settings")
}

model User {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  email       String          @unique
  password    String
  name        String
  address     String?
  zip         String?
  city        String?
  country     String?

  lastSeen    DateTime?
  settings    Json            @default("{}")

  projects    Project[]

  @@map(name: "users")
}

model Project {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  name        String

  userId      Int
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  flowPlans   FlowPlan[]

  @@map(name: "projects")
}

model FlowPlan {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  title       String
  state       Json            @default("{}")

  projectId   Int
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastStamp   DateTime?

  source      InputSource?
  batches     Batch[]
  inputItems  InputItem[]

  @@map(name: "flow_plans")
}

enum InputSourceType {
  TEST_MOCK_INPUT
  ENABLE_BANKING
}

model InputSource {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  type        InputSourceType
  url         String
  settings    Json            @default("{}")

  flowPlanId  Int             @unique
  flowPlan    FlowPlan?       @relation(fields: [flowPlanId], references: [id])

  @@map(name: "input_sources")
}

enum BatchState {
  BATCH_CREATED
  DATA_FETCHED
  DATA_PARSED
  OUTPUT_CREATED
  OUTPUT_DELIVERED
}

model Batch{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt
  completed   DateTime?

  number      Int
  state       BatchState
  data        String?

  flowPlanId  Int
  flowPlan    FlowPlan?       @relation(fields: [flowPlanId], references: [id])
  runs        Run[]
  inputItems  InputItem[]

  @@map(name: "batches")
}

model Run{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  initialState BatchState
  finalState  BatchState

  error       String?

  batchId     Int
  batch       Batch?          @relation(fields: [batchId], references: [id])
  inputs      InputItem[]

  @@map(name: "runs")
}

model InputItem{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  data        Json
  processed   Boolean
  success     Boolean

  flowPlanId  Int
  flowPlan    FlowPlan?       @relation(fields: [flowPlanId], references: [id])
  batchId     Int
  batch       Batch?          @relation(fields: [batchId], references: [id])
  runId       Int
  run         Run?            @relation(fields: [runId], references: [id])

  @@map(name: "input_items")
}
