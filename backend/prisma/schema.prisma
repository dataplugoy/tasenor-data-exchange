datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
}

model Settings {
  id          Int             @id @default(autoincrement())
  type        DriverType      @unique
  url         String?
  certificate String?
  apikey      String?
  user        String?
  password    String?
  options     Json            @default("{}")

  @@map(name: "settings")
}

model User {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  email       String          @unique
  password    String
  name        String
  address     String?
  zip         String?
  city        String?
  country     String?

  admin       Boolean         @default(false)

  lastSeen    DateTime?
  settings    Json            @default("{}")

  projects    Project[]
  services    Service[]
  alerts      Alert[]

  @@map(name: "users")
}

enum ServiceType {
  CURRENCY_RATES
  CRYPTO_RATES
}

enum ServiceDriver {
  JSON_FILE
  TASENOR
}

model Service {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  type        ServiceType
  name        String
  driver      ServiceDriver
  free        Boolean
  settings    Json

  userId      Int
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map(name: "services")
}

model Project {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  name        String
  settings    Json            @default("{}")

  userId      Int
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  flowPlans   FlowPlan[]

  @@map(name: "projects")
}

model FlowPlan {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  title       String
  state       Json            @default("{}")

  projectId   Int
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastStamp   DateTime?
  stock       Json            @default("{}")

  source      InputSource?
  destination OutputDestination?
  batches     Batch[]
  inputItems  InputItem[]
  unifiedItems UnifiedItem[]
  outputItems OutputItem[]

  @@map(name: "flow_plans")
}

enum DriverType {
  TEST_MOCK
  NO_ACTION
  ENABLE_BANKING
  MANUAL_UPLOAD
  NORDNET
}

model InputSource {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  type        DriverType
  settings    Json            @default("{}")

  flowPlanId  Int             @unique
  flowPlan    FlowPlan?       @relation(fields: [flowPlanId], references: [id])

  @@map(name: "input_sources")
}

model OutputDestination {
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  type        DriverType
  settings    Json            @default("{}")

  flowPlanId  Int             @unique
  flowPlan    FlowPlan?       @relation(fields: [flowPlanId], references: [id])

  @@map(name: "output_destinations")
}

enum BatchState {
  BATCH_CREATED
  DATA_FETCHED
  DATA_PARSED
  ITEMS_UNIFIED
  OUTPUT_CREATED
  OUTPUT_DELIVERED
}

model Batch{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt
  completed   DateTime?

  number      Int
  state       BatchState
  data        String?
  lastStamp   DateTime?
  initialStock Json           @default("{}")
  endStock    Json            @default("{}")

  flowPlanId  Int
  flowPlan    FlowPlan?       @relation(fields: [flowPlanId], references: [id])
  runs        Run[]
  inputItems  InputItem[]
  unifiedItems UnifiedItem[]
  outputItems OutputItem[]

  @@map(name: "batches")
}

enum RunResult{
  ALL_SUCCESS
  PARTLY_SKIPPED_SUCCESS
  ALL_SKIPPED
  PARTLY_FAIL
  ALL_FAILED
  NO_PROGRESS
  WAITING
}

model Run{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  initialState BatchState
  finalState  BatchState

  error       String?
  done        Int?
  total       Int?
  result      RunResult       @default(NO_PROGRESS)

  batchId     Int
  batch       Batch?          @relation(fields: [batchId], references: [id])

  inputItems  InputItem[]
  unifiedItems UnifiedItem[]
  outputItems OutputItem[]

  @@map(name: "runs")
}

enum SkipReason{
  DUPLICATE
  IN_THE_PAST
}

model InputItem{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  data        Json
  hash        String          @db.VarChar(40)
  processed   Boolean
  skipped     Boolean
  skipReason  SkipReason?

  error       String?
  unifiedItem UnifiedItem?

  flowPlanId  Int
  flowPlan    FlowPlan        @relation(fields: [flowPlanId], references: [id])
  batchId     Int
  batch       Batch           @relation(fields: [batchId], references: [id])
  runId       Int
  run         Run             @relation(fields: [runId], references: [id])

  @@map(name: "input_items")
  @@index([flowPlanId, hash])
}

model UnifiedItem{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  time        DateTime
  data        Json
  stockChange Json            @default("{}")
  processed   Boolean
  skipped     Boolean

  error       String?
  outputItem  OutputItem?

  inputId     Int             @unique
  input       InputItem       @relation(fields: [inputId], references: [id])
  flowPlanId  Int
  flowPlan    FlowPlan        @relation(fields: [flowPlanId], references: [id])
  batchId     Int
  batch       Batch           @relation(fields: [batchId], references: [id])
  runId       Int
  run         Run             @relation(fields: [runId], references: [id])

  @@map(name: "unified_items")
}

model OutputItem{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  data        Json
  hash        String          @db.VarChar(40)
  skipped     Boolean
  delivered   Boolean

  error       String?

  unifiedId   Int             @unique
  unified     UnifiedItem     @relation(fields: [unifiedId], references: [id])
  flowPlanId  Int
  flowPlan    FlowPlan        @relation(fields: [flowPlanId], references: [id])
  batchId     Int
  batch       Batch           @relation(fields: [batchId], references: [id])
  runId       Int
  run         Run             @relation(fields: [runId], references: [id])

  @@map(name: "output_items")
  @@index([flowPlanId, hash])
  @@index([flowPlanId, delivered, created])
}

enum RuleType {
  INPUT_SOURCE
  FLOW
}

model Rule{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  type        RuleType
  ownerId     Int

  name        String
  key         String
  priority    Int             @default(50)
  filter      Json
  result      Json
  filterView  Json
  resultView  Json


  @@unique([type, ownerId, name])

  @@map(name: "rules")
}

enum AlertType {
  UPLOAD_REQUIRED
}

enum AlertMethod {
  INTERACTIVE
  EMAIL
}

model Alert{
  id          Int             @id @default(autoincrement())
  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  userId      Int
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        AlertType
  method      AlertMethod
  url         String
  payload     String
  delivered   DateTime?

  @@map(name: "alerts")
}
