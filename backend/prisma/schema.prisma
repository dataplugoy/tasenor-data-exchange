datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
}

model User {
  id          Int             @id @default(autoincrement())
  email       String          @unique
  name        String
  address     String?
  zip         String?
  city        String?
  country     String?

  last_seen   DateTime?

  created     DateTime        @default(now())
  updated     DateTime        @updatedAt

  @@map(name: "users")
}
